{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "CourserLabs shared Renovate preset. Use with: \"extends\": [\"github>CourserLabs/.github:renovate-config\"]",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Batch low-risk updates into one weekly PR.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "non-major dependencies"
    },
    {
      "description": "GitHub Actions: one PR, digests stay pinned.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Terraform providers: review plans before merging.",
      "matchManagers": ["terraform"],
      "groupName": "terraform providers"
    }
  ]
}
